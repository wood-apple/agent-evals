# At least one provider key. Keys are read by the worker and passed only to the provider they belong to.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Model used by the LLM judge (any LiteLLM model string). Validate it with `evals judge-validate`.
JUDGE_MODEL=gemini/gemini-3.5-flash
# Default spend cap per run, in USD.
EVALS_BUDGET_USD=5
